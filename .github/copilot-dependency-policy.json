{
  "_comment": "Policy for .github/workflows/copilot-dependency-updates.yml. A branch whose minor is released (tag vX.Y.0 exists) takes patch updates only; an unreleased minor takes minor and patch updates. Major updates are never proposed.",
  "dashboardAuthor": "app/renovate",
  "dashboardTitle": "Dependency Dashboard",
  "maxUpdatesPerRun": 10,
  "previousBranches": 1,
  "skipBranches": [
    "renovate/github-actions-*",
    "renovate/major-*"
  ],
  "skipPackages": [],
  "manualReviewPackages": [
    "org.jetbrains.kotlin*",
    "com.google.devtools.ksp*",
    "org.apache.groovy*",
    "io.micronaut*"
  ],
  "versionFiles": [
    "gradle/libs.versions.toml",
    "gradle.properties",
    "settings.gradle",
    "settings.gradle.kts"
  ],
  "verifyTasks": "assemble testClasses"
}
